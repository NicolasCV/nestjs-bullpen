{
  "name": "nestjs-bullpen",
  "version": "1.1.0",
  "description": "The NestJS-native BullMQ dashboard. Auto-discovers your queues, shows the processors behind them, runs on Express and Fastify, pluggable auth, zero runtime dependencies.",
  "keywords": [
    "bullmq dashboard",
    "nestjs bullmq",
    "nestjs bullmq dashboard",
    "bullmq ui",
    "bullmq board",
    "bullmq monitor",
    "bullmq admin",
    "bull board",
    "bull dashboard",
    "nestjs dashboard",
    "nestjs queue dashboard",
    "nestjs queue",
    "redis queue dashboard",
    "queue dashboard",
    "nestjs",
    "nest",
    "bullmq",
    "bull",
    "dashboard",
    "queue",
    "ui",
    "board",
    "monitor",
    "redis",
    "jobs"
  ],
  "license": "MIT",
  "author": "Nicolás Cárdenas",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NicolasCV/nestjs-bullpen.git"
  },
  "homepage": "https://github.com/NicolasCV/nestjs-bullpen#readme",
  "bugs": {
    "url": "https://github.com/NicolasCV/nestjs-bullpen/issues"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build:lib": "tsc -p tsconfig.build.json",
    "build:ui": "vite build --config ui/vite.config.ts",
    "build": "npm run clean && npm run build:lib && npm run build:ui",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\"",
    "example": "TS_NODE_TRANSPILE_ONLY=1 ts-node -P example/tsconfig.json example/src/main.ts",
    "example:fastify": "BULLPEN_PLATFORM=fastify TS_NODE_TRANSPILE_ONLY=1 ts-node -P example/tsconfig.json example/src/main.ts",
    "seed": "TS_NODE_TRANSPILE_ONLY=1 ts-node -P example/tsconfig.json example/src/seed.ts",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.0.0 || ^11.0.0",
    "@nestjs/core": "^10.0.0 || ^11.0.0",
    "bullmq": "^5.0.0",
    "reflect-metadata": "^0.1.13 || ^0.2.0",
    "rxjs": "^7.0.0"
  },
  "devDependencies": {
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.1.27",
    "@nestjs/core": "^11.1.27",
    "@nestjs/platform-express": "^11.1.27",
    "@nestjs/platform-fastify": "^11.1.27",
    "@nestjs/testing": "^11.1.27",
    "@preact/preset-vite": "^2.10.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.0.0",
    "bullmq": "^5.79.1",
    "eslint": "^10.5.0",
    "jest": "^30.4.2",
    "preact": "^10.29.2",
    "prettier": "^3.8.4",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.1.3",
    "rxjs": "^7.8.2",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0",
    "vite": "^6.4.3",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
